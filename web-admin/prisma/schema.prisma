generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model classes {
  id           String         @id
  name         String
  teacher_id   String?        // 可选：班级可以暂时没有老师
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now())
  updated_at   DateTime
  teachers     teachers?      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  plan_classes plan_classes[]
  students     students[]
}

model daily_tasks {
  id           String       @id
  studentId    String
  vocabularyId String
  taskDate     DateTime     @db.Date
  status       TaskStatus   @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  students     students     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabularies vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([studentId, vocabularyId, taskDate])
  @@index([studentId, taskDate])
}

model plan_classes {
  id            String          @id
  class_id      String
  pack_id       String          // 词汇库ID（必填）
  status        PlanClassStatus @default(ACTIVE)
  start_date    DateTime        @db.Date
  created_at    DateTime        @default(now())
  updated_at    DateTime
  classes       classes         @relation(fields: [class_id], references: [id], onDelete: Cascade)
  vocabulary_packs vocabulary_packs @relation(fields: [pack_id], references: [id], onDelete: Cascade)

  @@unique([class_id, pack_id])
  @@index([class_id])
  @@index([status])
  @@index([pack_id])
}

model question_options {
  id         String    @id
  questionId String
  content    String
  isCorrect  Boolean   @default(false)
  order      Int
  createdAt  DateTime  @default(now())
  questions  questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model questions {
  id               String             @id
  vocabularyId     String
  type             QuestionType
  content          String
  sentence         String?
  audioUrl         String?
  correctAnswer    String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  question_options question_options[]
  vocabularies     vocabularies       @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  wrong_questions  wrong_questions[]
  question_answers question_answers[]
}

model students {
  id              String            @id
  user_id         String            @unique
  student_no      String            @unique
  class_id        String
  wechat_id       String?           @unique
  created_at      DateTime          @default(now())
  updated_at      DateTime
  daily_tasks     daily_tasks[]
  classes         classes           @relation(fields: [class_id], references: [id], onDelete: Cascade)
  user            user              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  study_plans     study_plans[]
  study_records   study_records[]
  test_records    test_records[]
  word_masteries  word_masteries[]
  wrong_questions wrong_questions[]
  student_points  student_points?
  point_history   point_history[]
  student_achievements student_achievements[]
  study_streaks   study_streaks?
  question_answers question_answers[]
  student_badges  student_badges[]
  achievement_redemptions achievement_redemptions[]

  @@index([class_id])
}

model study_plans {
  id           String          @id
  studentId    String
  vocabularyId String
  status       StudyPlanStatus @default(LEARNING)
  reviewCount  Int             @default(0)
  lastReviewAt DateTime?
  nextReviewAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  students     students        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabularies vocabularies    @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([studentId, vocabularyId])
  @@index([studentId, status])
  @@index([studentId, nextReviewAt])
}

model study_records {
  id             String    @id
  studentId      String
  taskDate       DateTime  @db.Date
  totalWords     Int
  completedWords Int
  correctCount   Int
  wrongCount     Int
  accuracy       Float
  totalTime      Int
  startedAt      DateTime
  completedAt    DateTime?
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  status         String?   @default("COMPLETED")
  lastActiveAt   DateTime?
  students       students  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, taskDate])
  @@index([studentId, status])
}

model system_configs {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model teachers {
  id         String    @id
  user_id    String    @unique
  school     String?
  subject    String?   @default("英语")
  created_at DateTime  @default(now())
  updated_at DateTime
  classes    classes[]
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user {
  id         String    @id
  email      String?   @unique
  phone      String?   @unique
  password   String
  name       String
  role       String    @default("STUDENT")
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime
  students   students?
  teachers   teachers?

  @@map("users")
}

model vocabularies {
  id                String            @id
  word              String            @unique
  part_of_speech    String[]
  primary_meaning   String
  secondary_meaning String?
  phonetic          String?
  phonetic_us       String?
  phonetic_uk       String?
  audio_url         String?
  is_high_frequency Boolean           @default(false)
  difficulty        String            @default("MEDIUM")
  created_at        DateTime          @default(now())
  updated_at        DateTime
  daily_tasks       daily_tasks[]
  questions         questions[]
  study_plans       study_plans[]
  word_audios       word_audios[]
  word_images       word_images[]
  word_masteries    word_masteries[]
  word_meanings     word_meanings[]
  wrong_questions   wrong_questions[]
  question_answers  question_answers[]
  pack_day_words    vocabulary_pack_day_words[]
}

model word_audios {
  id           String       @id
  vocabularyId String
  audioUrl     String
  accent       String       @default("US")
  duration     Int?
  createdAt    DateTime     @default(now())
  vocabularies vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
}

model word_images {
  id           String       @id
  vocabularyId String
  imageUrl     String
  description  String?
  createdAt    DateTime     @default(now())
  vocabularies vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
}

model word_meanings {
  id             String       @id
  vocabularyId   String
  partOfSpeech   String       // 词性: n., v., adj., adv., prep., conj., pron., etc.
  meaning        String       // 该词性下的释义
  orderIndex     Int          @default(0) // 显示顺序
  examples       String[]     @default([]) // 例句数组
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  vocabularies   vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@index([partOfSpeech])
  @@index([vocabularyId, orderIndex])
}

model word_masteries {
  id                 String       @id
  studentId          String
  vocabularyId       String
  totalWrongCount    Int          @default(0)
  recentAccuracy     Float?
  consecutiveCorrect Int          @default(0)
  isMastered         Boolean      @default(false)
  isDifficult        Boolean      @default(false)
  lastPracticeAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime
  students           students     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabularies       vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([studentId, vocabularyId])
  @@index([studentId, isDifficult])
  @@index([studentId, isMastered])
}

model wrong_questions {
  id            String       @id
  studentId     String
  vocabularyId  String
  questionId    String
  wrongAnswer   String
  correctAnswer String
  wrongCount    Int          @default(1) // 答错次数
  correctCount  Int          @default(0) // 重测答对次数
  status        WrongQuestionStatus @default(ACTIVE) // 错题状态
  wrongAt       DateTime     @default(now())
  lastReviewAt  DateTime?    // 最后复习时间
  questions     questions    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  students      students     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabularies  vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([studentId, vocabularyId])
  @@index([studentId, status])
}


model proficiency_tests {
  id           String        @id
  name         String        // 测试名称，如"高考核心词汇测试"
  description  String?       // 测试描述
  vocabularyIds String[]     // 测试包含的词汇ID列表
  totalWords   Int           // 总词汇数
  passScore    Int           @default(60) // 及格分数
  duration     Int?          // 测试时长（分钟），null表示不限时
  isActive     Boolean       @default(true) // 是否启用
  createdBy    String        // 创建者（教师ID）
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  test_records test_records[]

  @@index([isActive])
  @@index([createdBy])
}

model test_records {
  id              String            @id
  testId          String            // 测试ID
  studentId       String            // 学生ID
  totalQuestions  Int               // 总题数
  correctCount    Int               // 正确数
  wrongCount      Int               // 错误数
  score           Int               // 得分
  accuracy        Float             // 正确率
  totalTime       Int               // 总用时（秒）
  startedAt       DateTime          // 开始时间
  completedAt     DateTime?         // 完成时间
  isCompleted     Boolean           @default(false) // 是否完成
  answers         Json              // 答题详情 [{vocabularyId, questionId, answer, isCorrect}]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  proficiency_tests proficiency_tests @relation(fields: [testId], references: [id], onDelete: Cascade)
  students        students          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([studentId])
  @@index([studentId, testId])
  @@index([createdAt])
}

enum QuestionType {
  ENGLISH_TO_CHINESE
  CHINESE_TO_ENGLISH
  LISTENING
  FILL_IN_BLANK
}

enum StudyPlanStatus {
  LEARNING
  MASTERED
}

enum PlanClassStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
}

enum UserRole {
  TEACHER
  STUDENT
  ADMIN
}

enum WordDifficulty {
  EASY
  MEDIUM
  HARD
}

model operation_logs {
  id          String   @id @default(cuid())
  userId      String              // 操作用户ID
  userName    String              // 操作用户名称（冗余存储）
  action      String              // 操作类型：CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  module      String              // 模块：accounts, students, vocabularies 等
  target      String?             // 操作对象描述
  targetId    String?             // 操作对象ID
  detail      Json?               // 操作详情（JSON）
  ip          String?             // 客户端IP
  userAgent   String?             // 浏览器信息
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model student_points {
  id          String   @id
  studentId   String
  totalPoints Int      @default(0) // 总积分
  dailyPoints Int      @default(0) // 今日积分
  weeklyPoints Int     @default(0) // 本周积分
  monthlyPoints Int    @default(0) // 本月积分
  level       Int      @default(1) // 等级
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students    students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])
  @@index([totalPoints])
  @@index([level])
}

model point_history {
  id          String   @id
  studentId   String
  points      Int      // 积分变化（正数为增加，负数为减少）
  reason      String   // 原因（如：完成学习、连续签到、测试通过等）
  relatedType String?  // 关联类型（study_record, test_record, achievement等）
  relatedId   String?  // 关联ID
  createdAt   DateTime @default(now())
  students    students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model achievements {
  id          String   @id
  name        String   // 成就名称
  description String   // 成就描述
  icon        String   // 成就图标
  type        String   // 成就类型(study, test, streak, mastery等)
  condition   Json     // 达成条件(JSON格式)
  points      Int      @default(0) // 奖励积分
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student_achievements student_achievements[]
  badges      badges[] // 关联的勋章

  @@index([type])
  @@index([isActive])
}

model student_achievements {
  id            String       @id
  studentId     String
  achievementId String
  unlockedAt    DateTime     @default(now())
  students      students     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievements  achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@index([unlockedAt])
}

model study_streaks {
  id            String   @id
  studentId     String
  currentStreak Int      @default(0) // 当前连续天数
  longestStreak Int      @default(0) // 最长连续天数
  lastStudyDate DateTime? // 最后学习日期
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  students      students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])
  @@index([currentStreak])
}

model question_answers {
  id           String       @id
  studentId    String
  vocabularyId String
  questionId   String
  answer       String       // 用户的选择/回答
  isCorrect    Boolean      // 是否正确
  timeSpent    Int?         // 答题耗时（秒）
  answeredAt   DateTime     @default(now())
  students     students     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabularies vocabularies @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  questions    questions    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentId, vocabularyId])
  @@index([studentId, answeredAt])
}

model vocabulary_packs {
  id          String   @id
  name        String   @unique  // "高考核心词汇10天班"
  description String?
  totalDays   Int      // 总天数，如10、20
  totalWords  Int      @default(0) // 总词汇数（自动统计）
  isActive    Boolean  @default(true)
  createdBy   String   // 创建者教师ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pack_days    vocabulary_pack_days[]
  plan_classes plan_classes[]

  @@index([isActive])
  @@index([createdBy])
}

model vocabulary_pack_days {
  id         String   @id
  packId     String
  dayNumber  Int      // 1, 2, 3...
  title      String?  // "Day1 - 基础动词"
  wordCount  Int      @default(0) // 该天词汇数（自动统计）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pack      vocabulary_packs           @relation(fields: [packId], references: [id], onDelete: Cascade)
  day_words vocabulary_pack_day_words[]

  @@unique([packId, dayNumber])
  @@index([packId])
}

model vocabulary_pack_day_words {
  id           String @id
  packDayId    String
  vocabularyId String
  orderIndex   Int    @default(0) // 排序

  pack_day   vocabulary_pack_days @relation(fields: [packDayId], references: [id], onDelete: Cascade)
  vocabulary vocabularies         @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([packDayId, vocabularyId])
  @@index([packDayId])
}

// 勋章定义表
model badges {
  id            String   @id
  name          String   // 勋章名称
  icon          String   // 勋章图标 emoji
  description   String   // 勋章描述
  rarity        BadgeRarity // 稀有度
  achievementId String?  // 关联的成就ID(可选)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  achievements  achievements? @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  student_badges student_badges[]

  @@index([rarity])
  @@index([isActive])
}

// 学生勋章表
model student_badges {
  id           String   @id
  studentId    String
  badgeId      String
  unlockedAt   DateTime @default(now())
  isDisplayed  Boolean  @default(true) // 是否在用户名旁显示
  displayOrder Int      @default(0) // 显示顺序(1-3)
  students     students @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badges       badges   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId, isDisplayed])
  @@index([studentId, displayOrder])
}

// 可兑换成就表
model redeemable_achievements {
  id          String   @id
  name        String   // 成就名称
  icon        String   // 图标
  description String   // 描述
  pointsCost  Int      // 所需积分
  category    String   @default("decoration") // 类别: decoration, badge等
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions achievement_redemptions[]

  @@index([isActive])
  @@index([pointsCost])
}

// 成就兑换记录表
model achievement_redemptions {
  id            String   @id
  studentId     String
  achievementId String
  pointsSpent   Int      // 消耗的积分
  redeemedAt    DateTime @default(now())
  students      students @relation(fields: [studentId], references: [id], onDelete: Cascade)
  redeemable_achievements redeemable_achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@index([redeemedAt])
}

// 勋章稀有度枚举
enum BadgeRarity {
  COMMON    // 普通
  RARE      // 稀有
  EPIC      // 史诗
  LEGENDARY // 传说
}

// 错题状态枚举
enum WrongQuestionStatus {
  ACTIVE     // 活跃(仍在错题本中)
  CONFIRMED  // 待确认(答对1次)
  MASTERED   // 已掌握(答对2次,已移除)
}

