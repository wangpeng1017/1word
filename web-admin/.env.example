# Database (主库 - 读写)
DATABASE_URL="postgresql://username:password@localhost:5432/vocab_assistant?schema=public"

# Database Replica (从库 - 只读，可选)
# 配置后自动启用读写分离，SELECT 查询走从库，减轻主库压力
# DATABASE_URL_REPLICA="postgresql://username:password@replica-host:5432/vocab_assistant?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Vercel Blob Storage (for file uploads)
# Get your token from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXX"

# Cron Job Secret (for scheduled tasks)
CRON_SECRET="your-cron-secret-key-change-this-in-production"
