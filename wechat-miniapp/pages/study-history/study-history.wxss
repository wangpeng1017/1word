/* pages/study-history/study-history.wxss */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

.period-picker {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f3f4f6;
  border-radius: 20rpx;
}

.period-text {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
  margin-right: 8rpx;
}

.period-arrow {
  font-size: 20rpx;
  color: #667eea;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
  border-radius: 16rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.stat-value.accent {
  color: #667eea;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 图表卡片 */
.chart-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
}

.chart-section {
  margin-bottom: 40rpx;
}

.chart-section:last-child {
  margin-bottom: 0;
}

.chart-label {
  font-size: 28rpx;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.chart-container {
  width: 100%;
  overflow-x: auto;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding: 20rpx 0;
  gap: 12rpx;
}

.chart-bar-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
}

.chart-bar {
  width: 100%;
  min-height: 40rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
  position: relative;
  transition: all 0.3s ease;
}

.chart-bar.secondary {
  background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
}

.bar-value {
  font-size: 20rpx;
  color: white;
  font-weight: bold;
}

.bar-label {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 12rpx;
  text-align: center;
}

/* 加载和空状态 */
.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.loading text {
  font-size: 28rpx;
  color: #9ca3af;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 学习记录列表 */
.records-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.date-group {
  display: flex;
  flex-direction: column;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e5e7eb;
  margin-bottom: 16rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

.date-stats {
  display: flex;
  gap: 16rpx;
}

.date-stat {
  font-size: 24rpx;
  color: #6b7280;
}

.records-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s ease;
}

.record-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
}

.record-time {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.time-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.time-text {
  font-size: 24rpx;
  color: #6b7280;
}

.record-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.record-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-stat .stat-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.record-stat .stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.record-stat .stat-value.correct {
  color: #10b981;
}

.record-stat .stat-value.wrong {
  color: #ef4444;
}

.record-stat .stat-value.accent {
  color: #667eea;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #e5e7eb;
}

.record-time-spent {
  font-size: 24rpx;
  color: #6b7280;
}

.record-arrow {
  font-size: 32rpx;
  color: #9ca3af;
}
