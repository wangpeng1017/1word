<!--pages/study-history/study-history.wxml-->
<wxs src="../../utils/format.wxs" module="fmt" />
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty">
    <text class="empty-icon">📚</text>
    <text class="empty-text">暂无学习记录</text>
    <text class="empty-hint">完成学习后会显示在这里</text>
  </view>

  <!-- 学习记录列表 -->
  <view wx:else class="records-section">
    <view class="section-title">学习记录</view>

    <view class="records-list">
      <view
        wx:for="{{filteredRecords}}"
        wx:key="date"
        wx:for-item="dateGroup"
        wx:for-index="dateIndex"
        class="date-group"
      >
        <!-- 日期标题 -->
        <view class="date-header">
          <text class="date-text">{{dateGroup.date}}</text>
          <view class="date-stats">
            <text class="date-stat">{{dateGroup.totalWords}}题</text>
            <text class="date-stat">{{dateGroup.totalCorrect}}对</text>
            <text class="date-stat">{{dateGroup.totalWrong}}错</text>
          </view>
        </view>

        <!-- 该日期的学习记录 -->
        <view class="records-group">
          <view
            wx:for="{{dateGroup.records}}"
            wx:key="id"
            wx:for-item="record"
            wx:for-index="recordIndex"
            class="record-item"
            data-date-index="{{dateIndex}}"
            data-record-index="{{recordIndex}}"
            bindtap="viewDetail"
          >
            <view class="record-time">
              <text class="time-icon">🕐</text>
              <text class="time-text">{{fmt.formatTime(record.createdAt)}}</text>
            </view>

            <view class="record-stats">
              <view class="record-stat">
                <text class="stat-label">题数</text>
                <text class="stat-value">{{record.totalWords}}</text>
              </view>
              <view class="record-stat">
                <text class="stat-label">正确</text>
                <text class="stat-value correct">{{record.correctCount}}</text>
              </view>
              <view class="record-stat">
                <text class="stat-label">错误</text>
                <text class="stat-value wrong">{{record.wrongCount}}</text>
              </view>
              <view class="record-stat">
                <text class="stat-label">正确率</text>
                <text class="stat-value accent">{{(record.correctCount + record.wrongCount) > 0 ? fmt.round((record.correctCount / (record.correctCount + record.wrongCount)) * 100) : 0}}%</text>
              </view>
            </view>

            <view class="record-footer">
              <text class="record-time-spent">⏱ 用时 {{fmt.floor((record.totalTime || 0) / 60)}}分{{(record.totalTime || 0) % 60}}秒</text>
              <text class="record-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
