<!--pages/points-history/points-history.wxml-->
<view class="page">
  <view class="header">
    <view class="title">积分历史</view>
    <view class="subtitle">查看积分变动记录</view>
  </view>

  <!-- 积分统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{totalEarned}}</text>
      <text class="stat-label">累计获得</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{historyCount}}</text>
      <text class="stat-label">记录数</text>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="history-list">
    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="id"
    >
      <view class="history-icon {{item.points > 0 ? 'positive' : 'negative'}}">
        <text>{{item.points > 0 ? '+' : ''}}{{item.points}}</text>
      </view>

      <view class="history-content">
        <text class="history-reason">{{item.reason}}</text>
        <text class="history-date">{{formatDate(item.createdAt)}}</text>
      </view>

      <view class="history-type" wx:if="{{item.relatedType}}">
        <text>{{getTypeLabel(item.relatedType)}}</text>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
      <text>加载更多</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && history.length > 0}}">
      <text>没有更多了</text>
    </view>

    <view class="empty" wx:if="{{history.length === 0 && !loading}}">
      <text>暂无积分记录</text>
    </view>
  </view>
</view>
