/* pages/points-history/points-history.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFFFFF 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF7A7A;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.stat-divider {
  width: 1rpx;
  background: #E5E7EB;
  margin: 0 24rpx;
}

/* 历史记录列表 */
.history-list {
  padding: 0 32rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.history-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.history-icon.positive {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.history-icon.negative {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #FFFFFF;
}

.history-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-reason {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.history-date {
  font-size: 24rpx;
  color: #9CA3AF;
}

.history-type {
  padding: 6rpx 16rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #6B7280;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 28rpx;
  color: #FF7A7A;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}
