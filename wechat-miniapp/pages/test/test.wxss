/* pages/test/test.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFFFFF 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

/* 测试列表 */
.test-list {
  padding: 0 32rpx;
}

.test-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.test-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.test-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
}

.test-badge {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 4rpx 16rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
}

.test-desc {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.test-info {
  display: flex;
  gap: 24rpx;
}

.info-item {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 测试详情 */
.test-detail {
  padding: 0 32rpx;
}

.detail-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.detail-info {
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #6B7280;
}

.value {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.tips {
  background: #FFF5F5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF7A7A;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* 测试进行中 */
.testing {
  padding: 0 32rpx;
}

.test-progress {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.time-left {
  color: #FF7A7A;
  font-weight: bold;
}

.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.question-type {
  font-size: 24rpx;
  color: #FF7A7A;
  margin-bottom: 16rpx;
}

.question-content {
  font-size: 36rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.question-sentence {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.audio-btn {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #FFF5F5;
  color: #FF7A7A;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option {
  padding: 24rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1F2937;
  transition: all 0.3s;
}

.option.selected {
  background: #FFF5F5;
  border-color: #FF7A7A;
  color: #FF7A7A;
}

.fill-blank {
  margin-top: 32rpx;
}

.fill-input {
  width: 100%;
  padding: 24rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 测试结果 */
.result {
  padding: 0 32rpx;
}

.result-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-score {
  margin-bottom: 24rpx;
}

.result-score.passed {
  color: #10B981;
}

.result-score.failed {
  color: #EF4444;
}

.score-num {
  font-size: 120rpx;
  font-weight: bold;
}

.score-label {
  font-size: 36rpx;
  margin-left: 8rpx;
}

.result-status {
  margin-bottom: 40rpx;
}

.pass-text {
  font-size: 32rpx;
  color: #10B981;
  font-weight: bold;
}

.fail-text {
  font-size: 32rpx;
  color: #EF4444;
  font-weight: bold;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  border-top: 1rpx solid #F3F4F6;
  border-bottom: 1rpx solid #F3F4F6;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.result-time {
  font-size: 28rpx;
  color: #6B7280;
}

/* 按钮 */
.actions {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.btn-primary,
.btn-secondary,
.btn-next {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary {
  background: linear-gradient(135deg, #FF7A7A 0%, #FF5A5A 100%);
  color: #FFFFFF;
}

.btn-secondary {
  background: #F3F4F6;
  color: #6B7280;
}

.btn-next {
  width: 100%;
  margin: 0 32rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #FF5A5A 100%);
  color: #FFFFFF;
}

.btn-next[disabled] {
  background: #E5E7EB;
  color: #9CA3AF;
}

/* 通用 */
.empty,
.loading,
.error {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.error button {
  margin-top: 32rpx;
}


/* 答题反馈 */
.feedback-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.feedback-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  width: 80%;
  max-width: 600rpx;
}

.feedback-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.feedback-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.feedback-correct {
  color: #10B981;
}

.feedback-wrong {
  color: #EF4444;
}

.feedback-answer {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
}

.option.correct {
  background: #D1FAE5;
  border-color: #10B981;
  color: #10B981;
}

.option.wrong {
  background: #FEE2E2;
  border-color: #EF4444;
  color: #EF4444;
}

/* 听力题喇叭图标 */
.listening-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #FF5A5A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.listening-icon text {
  font-size: 60rpx;
  color: #FFFFFF;
}
