<!--pages/test/test.wxml-->
<view class="page">
  <view class="header">
    <view class="title">词汇熟练度测试</view>
    <view class="subtitle">测试你的词汇掌握情况</view>
  </view>

  <!-- 测试列表 -->
  <block wx:if="{{state==='list'}}">
    <view class="test-list">
      <view class="test-item" wx:for="{{tests}}" wx:key="id" bindtap="selectTest" data-test="{{item}}">
        <view class="test-header">
          <view class="test-name">{{item.name}}</view>
          <view class="test-badge" wx:if="{{!item.isActive}}">已停用</view>
        </view>
        <view class="test-desc" wx:if="{{item.description}}">{{item.description}}</view>
        <view class="test-info">
          <text class="info-item">📚 {{item.totalWords}}词</text>
          <text class="info-item">⏱️ {{item.duration ? item.duration + '分钟' : '不限时'}}</text>
          <text class="info-item">✅ 及格{{item.passScore}}分</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{tests.length === 0}}">
      <text>暂无可用测试</text>
    </view>
  </block>

  <!-- 测试详情 -->
  <block wx:elif="{{state==='detail'}}">
    <view class="test-detail">
      <view class="detail-card">
        <view class="detail-title">{{selectedTest.name}}</view>
        <view class="detail-desc" wx:if="{{selectedTest.description}}">{{selectedTest.description}}</view>

        <view class="detail-info">
          <view class="info-row">
            <text class="label">词汇数量：</text>
            <text class="value">{{selectedTest.totalWords}}个</text>
          </view>
          <view class="info-row">
            <text class="label">测试时长：</text>
            <text class="value">{{selectedTest.duration ? selectedTest.duration + '分钟' : '不限时'}}</text>
          </view>
          <view class="info-row">
            <text class="label">及格分数：</text>
            <text class="value">{{selectedTest.passScore}}分</text>
          </view>
        </view>

        <view class="tips">
          <view class="tips-title">📝 测试说明</view>
          <view class="tips-item">• 测试包含选择题和填空题</view>
          <view class="tips-item">• 请认真作答，测试结果将记录在案</view>
          <view class="tips-item">• 建议在安静的环境下完成测试</view>
        </view>
      </view>

      <view class="actions">
        <button class="btn-secondary" bindtap="backToList">返回</button>
        <button class="btn-primary" bindtap="startTest">开始测试</button>
      </view>
    </view>
  </block>

  <!-- 测试进行中 -->
  <block wx:elif="{{state==='testing'}}">
    <view class="testing">
      <view class="test-progress">
        <view class="progress-info">
          <text>第 {{currentIndex + 1}} / {{questions.length}} 题</text>
          <text wx:if="{{timeLeft !== null}}" class="time-left">剩余 {{timeLeft}}秒</text>
        </view>
        <progress percent="{{progressPercent}}" stroke-width="6" activeColor="#FF7A7A" />
      </view>

      <view class="question-card">
        <view class="question-type">{{questionTypeText}}</view>
        <!-- 听力题显示喇叭图标 -->
        <block wx:if="{{currentQuestion.type === 'LISTENING'}}">
          <view class="listening-icon" bindtap="playAudio">
            <text>🔊</text>
          </view>
          <view class="question-content" style="text-align:center;">点击播放发音，选择正确的单词</view>
        </block>
        <block wx:else>
          <view class="question-content">{{currentQuestion.content}}</view>
        </block>

        <!-- 例句 -->
        <view class="question-sentence" wx:if="{{currentQuestion.sentence}}">
          <text>{{currentQuestion.sentence}}</text>
        </view>

        <!-- 音频 -->
        <view class="audio-btn" wx:if="{{currentQuestion.audioUrl}}" bindtap="playAudio">
          <text>🔊 播放发音</text>
        </view>

        <!-- 选择题选项 -->
        <view class="options" wx:if="{{currentQuestion.type !== 'FILL_IN_BLANK'}}">
          <view
            class="option {{selectedAnswer === item.content ? 'selected' : ''}}"
            wx:for="{{currentQuestion.options}}"
            wx:key="id"
            bindtap="selectOption"
            data-answer="{{item.content}}"
          >
            <text>{{item.content}}</text>
          </view>
        </view>

        <!-- 填空题输入框 -->
        <view class="fill-blank" wx:if="{{currentQuestion.type === 'FILL_IN_BLANK'}}">
          <input
            class="fill-input"
            placeholder="请输入答案"
            value="{{fillAnswer}}"
            bindinput="onFillInput"
          />
        </view>
      </view>


      <!-- 答题反馈 -->
      <view class="feedback-overlay" wx:if="{{showFeedback}}">
        <view class="feedback-card">
          <view class="feedback-icon">{{isCurrentCorrect ? '✅' : '❌'}}</view>
          <view class="feedback-text {{isCurrentCorrect ? 'feedback-correct' : 'feedback-wrong'}}">
            {{isCurrentCorrect ? '回答正确！' : '回答错误'}}
          </view>
          <view class="feedback-answer" wx:if="{{!isCurrentCorrect}}">
            正确答案：{{correctAnswer}}
          </view>
          <button class="btn-primary" style="width:60%;margin:0 auto;" bindtap="continuNext">继续</button>
        </view>
      </view>

            <button class="btn-next" bindtap="nextQuestion" disabled="{{!canNext}}">
        {{currentIndex < questions.length - 1 ? '下一题' : '提交测试'}}
      </button>
    </view>
  </block>

  <!-- 测试结果 -->
  <block wx:elif="{{state==='result'}}">
    <view class="result">
      <view class="result-card">
        <view class="result-score {{isPassed ? 'passed' : 'failed'}}">
          <text class="score-num">{{result.score}}</text>
          <text class="score-label">分</text>
        </view>

        <view class="result-status">
          <text class="{{isPassed ? 'pass-text' : 'fail-text'}}">
            {{isPassed ? '🎉 恭喜通过' : '💪 继续加油'}}
          </text>
        </view>

        <view class="result-stats">
          <view class="stat-item">
            <text class="stat-value">{{result.correctCount}}</text>
            <text class="stat-label">正确</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{result.wrongCount}}</text>
            <text class="stat-label">错误</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{result.accuracy}}%</text>
            <text class="stat-label">正确率</text>
          </view>
        </view>

        <view class="result-time">
          <text>用时：{{Math.floor(result.totalTime / 60)}}分{{result.totalTime % 60}}秒</text>
        </view>
      </view>

      <view class="actions">
        <button class="btn-secondary" bindtap="backToList">返回列表</button>
        <button class="btn-primary" bindtap="viewDetails">查看详情</button>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <block wx:elif="{{state==='loading'}}">
    <view class="loading">
      <text>加载中...</text>
    </view>
  </block>

  <!-- 错误 -->
  <block wx:elif="{{state==='error'}}">
    <view class="error">
      <text>{{errorMsg}}</text>
      <button size="mini" bindtap="reload">重试</button>
    </view>
  </block>
</view>
