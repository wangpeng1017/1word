/* pages/badges/badges.wxss */
.container {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 30rpx;
}

/* 头部统计 */
.header-stats {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 122, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 勋章网格 */
.badges-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.badge-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.badge-card.locked {
  opacity: 0.5;
}

.badge-icon-large {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.badge-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #1F2937;
  text-align: center;
  margin-bottom: 8rpx;
}

.badge-rarity {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: #FFFFFF;
}

.rarity-COMMON {
  background: #9CA3AF;
}

.rarity-RARE {
  background: #3B82F6;
}

.rarity-EPIC {
  background: #A855F7;
}

.rarity-LEGENDARY {
  background: #F59E0B;
}

.unlocked-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  background: #10B981;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 20rpx;
}

.locked-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  opacity: 0.3;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}
