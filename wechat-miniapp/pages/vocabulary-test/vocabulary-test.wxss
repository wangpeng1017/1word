/* pages/vocabulary-test/vocabulary-test.wxss */
/* 词汇量测试页面样式，参考study.wxss */

.vocabulary-test-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
  padding: 0;
}

/* 介绍页 */
.intro-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.intro-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.intro-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
  max-width: 600rpx;
  margin-bottom: 48rpx;
}

.intro-tips {
  width: 100%;
  max-width: 500rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tip-item {
  font-size: 28rpx;
  color: #475569;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.tip-item:last-child {
  border-bottom: none;
}

.start-btn {
  width: 80%;
  max-width: 400rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 122, 0.3);
}

/* 加载中 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 测试区域 */
.test-section {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.test-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}

.header-info {
  display: flex;
  gap: 24rpx;
}

.question-count {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.time-spent {
  font-size: 28rpx;
  color: #64748b;
}

.exit-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #94a3b8;
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background: #e2e8f0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF7A7A 0%, #FF9E9E 50%, #FFC1C1 100%);
  transition: width 0.3s ease;
}

/* 题目区域 */
.question-area {
  padding: 48rpx 32rpx;
}

.word-display {
  text-align: center;
}

.word-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #1e293b;
  display: block;
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 36rpx;
  color: #334155;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.question-hint {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 选项列表 */
.options-list {
  padding: 0 32rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.option-item.selected {
  border-color: #FF7A7A;
  background: #FFF1F1;
}

.option-item.correct {
  border-color: #22c55e;
  background: #f0fdf4;
}

.option-item.wrong {
  border-color: #ef4444;
  background: #fef2f2;
}

.option-item.option-unknown {
  border-style: dashed;
  background: #fafafa;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #FF7A7A;
  color: #fff;
}

.option-item.correct .option-label {
  background: #22c55e;
  color: #fff;
}

.option-item.wrong .option-label {
  background: #ef4444;
  color: #fff;
}

.option-content {
  flex: 1;
  font-size: 30rpx;
  color: #334155;
}

.option-icon {
  font-size: 32rpx;
  margin-left: 16rpx;
}

.option-item.correct .option-icon {
  color: #22c55e;
}

.option-item.wrong .option-icon {
  color: #ef4444;
}

/* 结果反馈栏 - 参考 study.wxss 淡色背景风格 */
.result-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 100;
  animation: slideUpBar 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  max-height: 50vh;
  overflow-y: auto;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

@keyframes slideUpBar {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 正确：淡绿色填充背景 */
.result-bar.ok {
  background: #D9FFC4;
  color: #1F2937;
}

/* 错误：淡粉色填充背景 */
.result-bar.bad {
  background: #FFE1E1;
  color: #1F2937;
}

.result-main {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  line-height: 1.5;
}

.result-icon {
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 4rpx;
}

.result-bar.ok .result-icon {
  color: #10B981;
}

.result-bar.bad .result-icon {
  color: #DC2626;
}

.result-text {
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.result-bar.ok .result-text {
  color: #059669;
}

.result-bar.bad .result-text {
  color: #DC2626;
}

.result-detail {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.result-label {
  font-size: 26rpx;
  color: #4B5563;
  font-weight: 500;
}

.result-value {
  font-size: 26rpx;
  color: #DC2626;
  font-weight: 600;
}

.continue-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 122, 0.3);
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 122, 0.3);
}

.submit-btn[disabled] {
  background: #e2e8f0;
  color: #94a3b8;
}

/* 统计信息 */
.stats-section {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 48rpx;
  padding: 32rpx;
  margin: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
}

.stat-value.correct-color {
  color: #22c55e;
}

.stat-value.wrong-color {
  color: #ef4444;
}

.stat-value.unknown-color {
  color: #94a3b8;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #e2e8f0;
}

/* 结果页 */
.result-section {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.result-emoji {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 词汇量卡片 */
.vocab-card {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 32rpx;
  padding: 48rpx 64rpx;
  text-align: center;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 122, 122, 0.3);
}

.vocab-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.vocab-value {
  font-size: 96rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.vocab-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 统计卡片 */
.stats-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.stats-row:last-child {
  border-bottom: none;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e293b;
}

.stats-label {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  background: #f1f5f9;
  color: #475569;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 122, 0.3);
}
