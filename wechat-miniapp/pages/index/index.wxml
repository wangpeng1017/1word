<!--pages/index/index.wxml-->
<view class="page">
  <!-- 欢迎动画 (首次打开) -->
  <view class="welcome-animation" wx:if="{{showWelcome}}">
    <view class="mascot">👋</view>
    <view class="welcome-text">欢迎回来,{{userInfo.name || '同学'}}!</view>
    <view class="welcome-sub">继续你的学习之旅</view>
  </view>

  <!-- 顶部统计栏 -->
  <view class="top-stats" wx:if="{{!showWelcome}}">
    <view class="stat-item">
      <text class="stat-icon">🔥</text>
      <text class="stat-value">{{studyDaysData.streak || 0}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-icon">💎</text>
      <text class="stat-value">{{totalPoints || 0}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-icon">💖</text>
      <text class="stat-value">{{lives || 5}}</text>
    </view>
  </view>

  <!-- 时间轴容器 -->
  <scroll-view 
    class="timeline-container" 
    scroll-y 
    scroll-into-view="{{scrollTarget}}"
    wx:if="{{!showWelcome && studyDaysData}}"
  >
    <view class="timeline">
      <!-- DAY卡片 -->
      <view 
        wx:for="{{studyDaysData.days}}" 
        wx:key="day"
        id="day-{{item.day}}"
        class="day-card {{item.status}}"
        bindtap="handleDayClick"
        data-day="{{item}}"
      >
        <!-- 连接线 -->
        <view class="connector" wx:if="{{index < studyDaysData.days.length - 1}}"></view>
        
        <!-- 卡片内容 -->
        <view class="card-content">
          <!-- 状态图标 -->
          <view class="status-icon">
            <text wx:if="{{item.status === 'completed'}}">✅</text>
            <text wx:elif="{{item.status === 'current'}}">🔄</text>
            <text wx:elif="{{item.status === 'missed'}}">⚠️</text>
            <text wx:else>🔒</text>
          </view>

          <!-- DAY信息 -->
          <view class="day-info">
            <view class="day-number">DAY {{item.day}}</view>
            <view class="day-date">{{formatDate(item.date)}}</view>
            
            <!-- 已完成显示统计 -->
            <view class="day-stats" wx:if="{{item.status === 'completed'}}">
              <text class="stat-text">{{item.wordsCount}}词 · {{item.accuracy}}%</text>
            </view>
            
            <!-- 进行中显示按钮 -->
            <view class="day-action" wx:if="{{item.status === 'current'}}">
              <button class="start-btn" size="mini" bindtap="startReview">开始复习</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{!studyDaysData && !showWelcome}}">
    <text>加载中...</text>
  </view>
</view>
