<!--pages/index/index.wxml-->
<view class="page">
  <view class="header">
    <view class="date">{{dateStr}}</view>
    <view class="title">今日复习</view>
    <view class="book" wx:if="{{overview.bookName}}">
      <text class="book-name">{{overview.bookName}}</text>
    </view>
  </view>

  <block wx:if="{{state==='ready'}}">
    <!-- 今日复习任务卡片 -->
    <view class="task-card">
      <view class="task-header">
        <view class="task-title">📋 今日复习任务</view>
        <view class="task-badge" wx:if="{{overview.dueCount > 0}}">
          待完成 {{overview.dueCount - overview.reviewedCount}}
        </view>
      </view>
      
      <view class="task-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressPercent}}%"></view>
        </view>
        <view class="progress-info">
          <text class="progress-done">{{overview.reviewedCount}} / {{overview.dueCount}}</text>
          <text class="progress-percent">{{progressPercent}}%</text>
        </view>
      </view>
    </view>

    <!-- 明日预测卡片 -->
    <view class="forecast-card" wx:if="{{tomorrowReview > 0}}">
      <view class="forecast-header">
        <view class="forecast-title">📅 明日预测</view>
        <view class="forecast-badge {{tomorrowDifficulty}}">{{tomorrowDifficultyText}}</view>
      </view>
      <view class="forecast-content">
        <view class="forecast-num">{{tomorrowReview}}</view>
        <view class="forecast-label">预计复习单词</view>
      </view>
    </view>

    <!-- 复习池统计 -->
    <view class="pool-card" wx:if="{{pool}}">
      <view class="pool-title">📊 学习进度</view>
      <view class="pool-stats">
        <view class="pool-item">
          <view class="pool-num">{{pool.totalLearned}}</view>
          <view class="pool-label">总学习</view>
        </view>
        <view class="pool-item">
          <view class="pool-num">{{pool.mastered}}</view>
          <view class="pool-label">已掌握</view>
        </view>
        <view class="pool-item">
          <view class="pool-num">{{pool.masteryRate}}%</view>
          <view class="pool-label">掌握率</view>
        </view>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <view class="num">{{overview.dueCount}}</view>
        <view class="label">今日应复习</view>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <view class="num">{{overview.reviewedCount}}</view>
        <view class="label">已复习</view>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <view class="num">{{overview.timeString}}</view>
        <view class="label">今日用时</view>
      </view>
    </view>

    <button class="cta" type="primary" bindtap="startReview">
      {{overview.reviewedCount>0 && overview.reviewedCount<overview.dueCount ? '继续复习' : '开始复习'}}
    </button>
  </block>

  <block wx:elif="{{state==='empty'}}">
    <view class="empty">
      <view class="done">🎉 今日复习已完成</view>
      
      <!-- 明日预测卡片 -->
      <view class="forecast-card" wx:if="{{tomorrowReview > 0}}" style="margin: 30rpx 0;">
        <view class="forecast-header">
          <view class="forecast-title">📅 明日预测</view>
          <view class="forecast-badge {{tomorrowDifficulty}}">{{tomorrowDifficultyText}}</view>
        </view>
        <view class="forecast-content">
          <view class="forecast-num">{{tomorrowReview}}</view>
          <view class="forecast-label">预计复习单词</view>
        </view>
      </view>

      <!-- 复习池统计 -->
      <view class="pool-card" wx:if="{{pool}}" style="margin: 30rpx 0;">
        <view class="pool-title">📊 学习进度</view>
        <view class="pool-stats">
          <view class="pool-item">
            <view class="pool-num">{{pool.totalLearned}}</view>
            <view class="pool-label">总学习</view>
          </view>
          <view class="pool-item">
            <view class="pool-num">{{pool.mastered}}</view>
            <view class="pool-label">已掌握</view>
          </view>
          <view class="pool-item">
            <view class="pool-num">{{pool.masteryRate}}%</view>
            <view class="pool-label">掌握率</view>
          </view>
        </view>
      </view>
      
      <view class="stats" style="margin-top: 40rpx; margin-bottom: 40rpx;">
        <view class="stat">
          <view class="num">{{overview.dueCount}}</view>
          <view class="label">今日应复习</view>
        </view>
        <view class="divider"></view>
        <view class="stat">
          <view class="num">{{overview.reviewedCount}}</view>
          <view class="label">已复习</view>
        </view>
        <view class="divider"></view>
        <view class="stat">
          <view class="num">{{overview.timeString}}</view>
          <view class="label">今日用时</view>
        </view>
      </view>

      <view class="sub">下次复习预计：{{nextReviewHint}}</view>
    </view>
  </block>

  <block wx:elif="{{state==='loading'}}">
    <view class="skeleton"></view>
  </block>

  <block wx:elif="{{state==='error'}}">
    <view class="error">
      <text>加载失败</text>
      <button size="mini" bindtap="reload">重试</button>
    </view>
  </block>
</view>
