/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0F9FF 0%, #F9FAFB 100%);
  position: relative;
}

/* ========== 欢迎动画 ========== */
.welcome-animation {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.mascot {
  font-size: 120rpx;
  animation: flyIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.welcome-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 40rpx;
  animation: fadeInUp 0.6s ease 0.3s both;
}

.welcome-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
  animation: fadeInUp 0.6s ease 0.5s both;
}

@keyframes flyIn {
  0% {
    transform: translateY(100vh) scale(0.5);
    opacity: 0;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 顶部统计栏 ========== */
.top-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E7EB;
  position: sticky;
  top: 0;
  z-index: 100;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

/* ========== 时间轴容器 ========== */
.timeline-container {
  height: calc(100vh - 100rpx);
  padding: 40rpx 0;
}

.timeline {
  padding: 0 60rpx;
  position: relative;
}

/* ========== DAY卡片 ========== */
.day-card {
  position: relative;
  margin-bottom: 60rpx;
  animation: slideIn 0.4s ease both;
}

.day-card:nth-child(1) { animation-delay: 0.1s; }
.day-card:nth-child(2) { animation-delay: 0.15s; }
.day-card:nth-child(3) { animation-delay: 0.2s; }
.day-card:nth-child(4) { animation-delay: 0.25s; }
.day-card:nth-child(5) { animation-delay: 0.3s; }

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 连接线 */
.connector {
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #D1D5DB 0%, #E5E7EB 100%);
  z-index: 0;
}

.day-card.completed .connector {
  background: linear-gradient(180deg, #10B981 0%, #34D399 100%);
}

.day-card.current .connector {
  background: linear-gradient(180deg, #F59E0B 0%, #FBBF24 100%);
}

/* 卡片内容 */
.card-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
  transition: all 0.3s ease;
}

.day-card.completed .card-content {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border: 2rpx solid #10B981;
}

.day-card.current .card-content {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border: 2rpx solid #F59E0B;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

.day-card.missed .card-content {
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
  border: 2rpx solid #EF4444;
}

.day-card.locked .card-content {
  background: #F9FAFB;
  border: 2rpx dashed #D1D5DB;
  opacity: 0.6;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 12rpx 32rpx rgba(245, 158, 11, 0.4);
  }
}

/* 状态图标 */
.status-icon {
  font-size: 64rpx;
  flex-shrink: 0;
}

/* DAY信息 */
.day-info {
  flex: 1;
}

.day-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.day-date {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.day-stats {
  margin-top: 8rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #059669;
  font-weight: 500;
}

/* 开始按钮 */
.day-action {
  margin-top: 16rpx;
}

.start-btn {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 122, 0.3);
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #9CA3AF;
}
