/* pages/index/index.wxss */
.page {
  padding: 24rpx 32rpx 40rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%);
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.header .date {
  color: #9CA3AF;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.header .title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
}

.book {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  width: fit-content;
}

.cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #EEF2FF;
}

.book-name {
  margin-left: 16rpx;
  color: #374151;
  font-size: 28rpx;
  font-weight: 500;
}

.stats {
  margin-top: 40rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 122, 0.08);
  display: flex;
  align-items: center;
  border: 2rpx solid #FFF1F1;
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF7A7A;
  line-height: 1;
}

.label {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.divider {
  width: 2rpx;
  height: 48rpx;
  background: #F3F4F6;
}

.progress-wrap {
  margin: 48rpx 8rpx 0;
  position: relative;
}

.progress-text {
  position: absolute;
  right: 0;
  top: -36rpx;
  color: #6B7280;
  font-size: 24rpx;
  font-weight: 500;
}

.cta {
  margin-top: 60rpx;
  height: 108rpx;
  line-height: 108rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #FF6B6B 100%);
  border-radius: 54rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(255, 122, 122, 0.3);
  transition: all 0.2s;
}

.cta:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 122, 0.3);
}

.empty {
  margin-top: 160rpx;
  text-align: center;
  color: #374151;
}

.empty .done {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.empty .sub {
  margin-top: 16rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.skeleton {
  margin-top: 48rpx;
  height: 260rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #F3F4F6 25%, #E5E7EB 37%, #F3F4F6 63%);
  background-size: 400% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.error {
  margin-top: 120rpx;
  text-align: center;
  color: #EF4444;
}

/* 🎮 游戏化任务卡片 */
.task-card {
  background: linear-gradient(135deg, #FF7A7A 0%, #FFB347 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 122, 0.3);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.task-badge {
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.task-progress {
  margin-top: 8rpx;
}

.task-progress .progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.task-progress .progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.progress-done {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.progress-percent {
  font-size: 26rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
}



/* 明日预测卡片 */
.forecast-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.forecast-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.forecast-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.forecast-badge {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.forecast-badge.light {
  background: rgba(72, 187, 120, 0.9);
  color: #FFFFFF;
}

.forecast-badge.normal {
  background: rgba(237, 137, 54, 0.9);
  color: #FFFFFF;
}

.forecast-badge.heavy {
  background: rgba(245, 101, 101, 0.9);
  color: #FFFFFF;
}

.forecast-content {
  text-align: center;
  padding: 16rpx 0;
}

.forecast-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.forecast-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 复习池统计卡片 */
.pool-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #F3F4F6;
}

.pool-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 20rpx;
}

.pool-stats {
  display: flex;
  justify-content: space-around;
}

.pool-item {
  text-align: center;
}

.pool-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4F46E5;
  line-height: 1;
}

.pool-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}
