/* pages/redeem/redeem.wxss */
.container {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 30rpx;
}

/* 积分余额卡片 */
.points-card {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.3);
}

.points-icon {
  font-size: 80rpx;
  margin-right: 24rpx;
}

.points-info {
  flex: 1;
}

.points-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.points-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 成就列表 */
.achievements-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.achievement-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.achievement-card.redeemed {
  opacity: 0.6;
}

.achievement-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.achievement-info {
  flex: 1;
}

.achievement-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.achievement-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.achievement-cost {
  display: flex;
  align-items: center;
}

.cost-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.cost-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #F59E0B;
}

/* 兑换按钮 */
.redeem-btn {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  border: none;
}

.redeem-btn.disabled {
  background: #E5E7EB;
  color: #9CA3AF;
}

.redeemed-mark {
  font-size: 24rpx;
  color: #10B981;
  padding: 12rpx 24rpx;
  background: #D1FAE5;
  border-radius: 20rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}
