<!--pages/study/study.wxml-->
<view class="container study-page {{isCorrect && showResult ? 'celebrate' : ''}}">
  <!-- 头部信息 -->
  <view class="study-header">
    <view class="header-info">
      <text class="word-count">当前单词（第 {{currentIndex + 1}}/{{totalCount}} 个）</text>
      <text class="time-spent">已用时 {{elapsedTime}}</text>
    </view>
    <view class="exit-btn" bindtap="exitStudy">×</view>
  </view>

  <!-- 趣味进度条 -->
  <view class="fun-progress">
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progress}}%">
        <text class="progress-emoji">🚀</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 答题区域 -->
  <view wx:else class="study-content">
    <!-- 选择题模式1: 英文单词 + 4个中文释义选项 -->
    <view wx:if="{{currentQuestion.type === 'ENGLISH_TO_CHINESE'}}" class="word-display">
      <view class="word-row">
        <text class="word-text">{{currentTask.vocabulary.word}}</text>
        <view class="speaker" bindtap="playAudio">🔊</view>
      </view>
      <!-- 单词实物图片（仅新学单词显示，复习单词不显示） -->
      <image
        wx:if="{{currentTask.isNew && currentTask.vocabulary.imageUrl}}"
        class="word-image"
        src="{{currentTask.vocabulary.imageUrl}}"
        mode="aspectFit"
        lazy-load="{{true}}"
      />
      <text class="question-hint">请选择正确的中文释义</text>
    </view>

    <!-- 选择题模式2: 汉语 + 4个英文单词选项 -->
    <view wx:elif="{{currentQuestion.type === 'CHINESE_TO_ENGLISH'}}" class="word-display">
      <view wx:if="{{currentTask.vocabulary.meanings && currentTask.vocabulary.meanings.length > 0}}" class="meanings-display">
        <view wx:for="{{currentTask.vocabulary.meanings}}" wx:key="id" class="meaning-item">
          <text class="pos-tag">{{item.partOfSpeech}}</text>
          <text class="meaning-text">{{item.meaning}}</text>
        </view>
      </view>
      <text wx:else class="word-text chinese-text">暂无释义</text>
      <text class="question-hint">请选择正确的英文单词</text>
    </view>

    <!-- 选择题模式3: 英文单词读音 + 4个英文单词选项 -->
    <view wx:elif="{{currentQuestion.type === 'LISTENING'}}" class="word-display">
      <view class="audio-icon" bindtap="playAudio">🔊</view>
      <text class="question-hint">听音选词</text>
    </view>

    <!-- 选择题模式4: 选词填空 -->
    <view wx:elif="{{currentQuestion.type === 'FILL_IN_BLANK'}}" class="word-display">
      <view class="sentence-display">
        <text class="sentence-text">{{currentQuestion.content}}</text>
      </view>
      <text class="question-hint">选择正确的单词填空</text>
    </view>

    <!-- 默认显示 -->
    <view wx:else class="word-display">
      <text class="word-text">{{currentTask.vocabulary.word}}</text>
    </view>

    <!-- 选项列表 - 使用 A/B/C/D 标签比较 -->
    <view class="options-list">
      <view
        wx:for="{{currentQuestion.options}}"
        wx:key="id"
        class="option-item {{selectedAnswer === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') ? 'selected' : ''}} {{isAnswered && (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') === currentQuestion.correctAnswer ? 'correct' : ''}} {{isAnswered && selectedAnswer === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') && !isCorrect ? 'wrong' : ''}}"
        data-answer="{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}"
        bindtap="selectAnswer"
      >
        <view class="option-label">{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}</view>
        <view class="option-content">{{item.content}}</view>
        <view wx:if="{{isAnswered && (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') === currentQuestion.correctAnswer}}" class="option-icon">✓</view>
        <view wx:elif="{{isAnswered && selectedAnswer === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') && !isCorrect}}" class="option-icon">✗</view>
      </view>
    </view>

    <!-- 结果反馈（固定底部） -->
    <view wx:if="{{showResult}}" class="result-bar {{isCorrect ? 'ok' : 'bad'}}">
      <view class="result-main">
        <text class="result-icon">{{isCorrect ? '✓' : '✗'}}</text>
        <text class="result-text">{{isCorrect ? '回答正确' : '答错了'}}</text>

        <!-- 错误时显示正确答案 -->
        <view wx:if="{{!isCorrect}}" class="result-detail">
          <text class="result-label">正确答案：</text>
          <text class="result-value">{{currentQuestion.correctAnswer}}</text>
        </view>

        <!-- 释义展示（限制高度，可滚动） -->
        <scroll-view scroll-y class="result-meanings-scroll" wx:if="{{currentTask.vocabulary.meanings && currentTask.vocabulary.meanings.length > 0}}">
          <view wx:for="{{currentTask.vocabulary.meanings}}" wx:key="id" class="result-meaning-item">
            <text class="meaning-pos">{{item.partOfSpeech}}</text>
            <text class="meaning-content">{{item.meaning}}</text>
          </view>
        </scroll-view>
        <view wx:elif="{{currentTask.vocabulary.meanings && currentTask.vocabulary.meanings.length > 0}}" class="result-meanings-inline">
          <view wx:for="{{currentTask.vocabulary.meanings}}" wx:key="id" class="result-meaning-item">
            <text class="meaning-pos">{{item.partOfSpeech}}</text>
            <text class="meaning-content">{{item.meaning}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{isCorrect}}" class="fireworks">
        <view class="firework firework-1"></view>
        <view class="firework firework-2"></view>
        <view class="firework firework-3"></view>
        <view class="firework firework-4"></view>
        <view class="firework firework-5"></view>
      </view>

      <!-- 继续按钮（放在result-bar内部，避免被遮挡） -->
      <button
        wx:if="{{!isCorrect}}"
        class="continue-btn-inside"
        bindtap="nextQuestion"
      >
        继续
      </button>
    </view>

    <!-- 提交按钮（仅在未答题时显示） -->
    <view class="submit-section" wx:if="{{!isAnswered}}">
      <button
        class="submit-btn"
        bindtap="submitAnswer"
        disabled="{{!selectedAnswer}}"
      >
        提交答案
      </button>
    </view>

    <!-- 统计信息 (结果显示时隐藏，避免遮挡) -->
    <view class="stats-section" wx:if="{{!showResult}}">
      <view class="stat-item">
        <text class="stat-value correct-color">{{correctCount}}</text>
        <text class="stat-label">正确</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value wrong-color">{{wrongCount}}</text>
        <text class="stat-label">错误</text>
      </view>
    </view>

    <!-- 经验值获取动画 -->
    <view wx:if="{{showExpGain}}" class="exp-gain-animation">
      <text class="exp-text">+{{expGainValue}} 经验</text>
    </view>

    <!-- 连对次数显示 -->
    <view wx:if="{{consecutiveCorrect > 0 && isCorrect}}" class="streak-badge">
      <text class="streak-icon">🔥</text>
      <text class="streak-count">连对 {{consecutiveCorrect}} 题</text>
    </view>
  </view>

  <!-- 里程碑弹窗 -->
  <view wx:if="{{showMilestone}}" class="milestone-overlay" bindtap="closeMilestone">
    <view class="milestone-popup">
      <view class="milestone-icon">🔥</view>
      <view class="milestone-title">太棒了！</view>
      <view class="milestone-count">连对 {{milestoneCount}} 题</view>
      <view class="milestone-subtitle">继续保持！</view>
    </view>
  </view>
</view>
