/* pages/study/result.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.result-icon {
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 48rpx;
}

.accuracy-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 12rpx solid #FF7A7A;
  box-shadow: 0 0 20rpx rgba(255, 122, 122, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.accuracy-value {
  font-size: 72rpx;
  font-weight: 800;
  color: #FF7A7A;
  line-height: 1;
  margin-bottom: 8rpx;
}

.accuracy-label {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.stats-grid {
  display: flex;
  width: 100%;
  margin-bottom: 48rpx;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.stat-item.correct {
  background: #ECFDF5;
  border-color: #D1FAE5;
}

.stat-item.wrong {
  background: #FEF2F2;
  border-color: #FEE2E2;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.stat-item.correct .stat-value { color: #059669; }
.stat-item.wrong .stat-value { color: #DC2626; }

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #FF7A7A 0%, #FF6B6B 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 122, 0.3);
}

.btn-secondary {
  background: #FFFFFF;
  color: #FF7A7A;
  border: 2rpx solid #FF7A7A;
}

.encouragement {
  width: 100%;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  text-align: center;
  backdrop-filter: blur(4px);
}

.encouragement text {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 500;
}

/* 马到成功动画 */
.success-horse {
  width: 320rpx;
  height: 320rpx;
  animation: popIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
             gallop 2s ease-in-out infinite 0.8s;
}

@keyframes popIn {
  0% { opacity: 0; transform: scale(0.3) translateY(50rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes gallop {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-10rpx) rotate(-2deg); }
  75% { transform: translateY(-5rpx) rotate(2deg); }
}

/* 🎉 激励弹窗样式 */
.motivation-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.motivation-popup {
  width: 600rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F5 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 122, 122, 0.3);
  animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.motivation-icon {
  margin-bottom: 16rpx;
}

.motivation-emoji {
  font-size: 100rpx;
  animation: bounce 1s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.motivation-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF7A7A;
  margin-bottom: 12rpx;
}

.motivation-streak {
  margin-bottom: 16rpx;
}

.streak-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B6B;
  background: linear-gradient(135deg, #FFF0F0 0%, #FFE5E5 100%);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.motivation-message {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.motivation-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.motivation-stat-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.motivation-stat-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.motivation-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.motivation-stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.motivation-close-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #FF6B6B 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 122, 0.3);
}

.motivation-close-btn:active {
  transform: scale(0.98);
}
