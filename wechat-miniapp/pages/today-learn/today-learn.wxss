/* pages/today-learn/today-learn.wxss */
.page {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.welcome-section {
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

.task-card-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.task-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-icon {
  font-size: 80rpx;
  margin-bottom: 40rpx;
}

.count-number {
  font-size: 120rpx;
  font-weight: bold;
  color: #FF7A7A;
  line-height: 1;
  margin-bottom: 16rpx;
}

.count-label {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 24rpx;
}

.time-estimate {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 60rpx;
  background: #F9FAFB;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
}

.start-btn {
  background: #FF7A7A;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
  width: 100%;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 122, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 8rpx rgba(255, 122, 122, 0.2);
}

.done-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #10B981;
  margin-bottom: 16rpx;
}

.status-desc {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 60rpx;
}

.review-btn {
  background: #FFFFFF;
  color: #FF7A7A;
  border: 2rpx solid #FF7A7A;
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  border-radius: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #FF7A7A;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ========== 欢迎动画覆盖层 ========== */
.welcome-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 60rpx;
}

.welcome-close {
  position: absolute;
  top: 100rpx;
  left: 40rpx;
  font-size: 56rpx;
  color: #AFAFAF;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 100%;
}

/* 吉祥物容器 */
.mascot-container {
  position: relative;
  margin-bottom: 60rpx;
  animation: mascotBounce 2s ease-in-out infinite;
}

.mascot-img {
  width: 280rpx;
  height: 280rpx;
}

.mascot-shadow {
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 24rpx;
  background: radial-gradient(ellipse, rgba(0,0,0,0.15) 0%, transparent 70%);
  animation: shadowPulse 2s ease-in-out infinite;
}

@keyframes mascotBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes shadowPulse {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.15; }
  50% { transform: translateX(-50%) scale(0.8); opacity: 0.1; }
}

/* 欢迎文字 */
.welcome-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #3C3C3C;
  margin-bottom: 20rpx;
  text-align: center;
}

.welcome-sub {
  font-size: 32rpx;
  color: #777777;
  text-align: center;
  margin-bottom: 80rpx;
}

/* 开始按钮 */
.welcome-btn {
  width: 90%;
  max-width: 600rpx;
  height: 100rpx;
  background: linear-gradient(180deg, #58CC02 0%, #4CAF00 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 8rpx 0 #3D8B00, 0 12rpx 24rpx rgba(88, 204, 2, 0.3);
  position: absolute;
  bottom: 100rpx;
}

.welcome-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #3D8B00, 0 8rpx 16rpx rgba(88, 204, 2, 0.3);
}
