/* pages/today-learn/today-learn.wxss */
.page {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.welcome-section {
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

.task-card-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.task-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-icon {
  font-size: 80rpx;
  margin-bottom: 40rpx;
}

.count-number {
  font-size: 120rpx;
  font-weight: bold;
  color: #FF7A7A;
  line-height: 1;
  margin-bottom: 16rpx;
}

.count-label {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 24rpx;
}

.time-estimate {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 60rpx;
  background: #F9FAFB;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
}

.start-btn {
  background: #FF7A7A;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
  width: 100%;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 122, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 8rpx rgba(255, 122, 122, 0.2);
}

.done-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #10B981;
  margin-bottom: 16rpx;
}

.status-desc {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 60rpx;
}

.review-btn {
  background: #FFFFFF;
  color: #FF7A7A;
  border: 2rpx solid #FF7A7A;
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  border-radius: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #FF7A7A;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
