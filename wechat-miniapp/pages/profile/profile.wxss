/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 用户卡片（合并等级信息） */
.user-card {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 122, 0.3);
}

.user-left {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 24rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-level {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.level-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.level-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.level-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.points-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 统计区域 */
.stats-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 紧凑型统计网格 */
.stats-grid-compact {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.stat-card-compact {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.stat-card-compact.accent {
  background: linear-gradient(135deg, #FFEBEE 0%, #FCE4EC 100%);
}

.stat-value-compact {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF7A7A;
  margin-bottom: 4rpx;
}

.stat-card-compact.accent .stat-value-compact {
  color: #D32F2F;
}

.stat-label-compact {
  font-size: 20rpx;
  color: #6B7280;
}

/* 快捷链接 */
.quick-links {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.quick-link-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.quick-link-item:last-child {
  border-bottom: none;
}

.link-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.link-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
}

.link-badge {
  background: #FF7A7A;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.link-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
}

/* 菜单区域 */
.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
}

.menu-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
}

/* 音效开关样式 */
.menu-item.sound-toggle {
  padding: 20rpx 24rpx;
}

.menu-item.sound-toggle switch {
  transform: scale(0.85);
}
