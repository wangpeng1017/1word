/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.user-card {
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 122, 0.3);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 积分等级卡片 */
.points-card {
  /* 使用更柔和的暖橙色渐变，减少荧光感 */
  background: linear-gradient(135deg, #FFB94B 0%, #FF8C42 100%);
  border-radius: 16rpx;
  padding: 24rpx; /* 减小内边距 */
  margin-bottom: 24rpx; /* 减小外边距 */
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 66, 0.2);
}

.points-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx; /* 减小间距 */
}

.level-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx; /* 减小徽章尺寸 */
  border-radius: 20rpx;
}

.level-icon {
  font-size: 28rpx; /* 减小图标 */
  margin-right: 6rpx;
}

.level-text {
  font-size: 26rpx; /* 减小字号 */
  font-weight: bold;
  color: #FFFFFF;
}

.points-total {
  text-align: right;
}

.points-value {
  font-size: 40rpx; /* 减小字号 48->40 */
  font-weight: bold;
  color: #FFFFFF;
  display: block;
}

.points-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.level-progress {
  margin-bottom: 16rpx; /* 减小间距 */
}

.progress-bar {
  height: 10rpx; /* 减小高度 */
  background: rgba(255, 255, 255, 0.3);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 5rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}

.points-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx; /* 减小间距 */
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}

.points-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-stat-item .stat-value {
  font-size: 28rpx; /* 减小字号 */
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 2rpx;
}

.points-stat-item .stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 快捷链接 */
.quick-links {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.quick-link-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.quick-link-item:last-child {
  border-bottom: none;
}

.link-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.link-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.link-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.link-desc {
  font-size: 24rpx;
  color: #9CA3AF;
}

.link-arrow {
  font-size: 40rpx;
  color: #D1D5DB;
}

/* 时间段选择器 */
.period-selector {
  margin-bottom: 30rpx;
}

.period-picker {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.period-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.period-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* 统计区域 */
.stats-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

/* 学习概况 */
.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.overview-item.accent {
  background: linear-gradient(135deg, #FFEBEE 0%, #FCE4EC 100%);
}

.overview-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7A7A;
  margin-bottom: 6rpx;
}

.overview-item.accent .overview-value {
  color: #D32F2F;
}

.overview-label {
  font-size: 24rpx;
  color: #6B7280;
}

.time-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.time-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.time-text {
  font-size: 26rpx;
  color: #374151;
}

/* 词性分布 */
.pos-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pos-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pos-bar-container {
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 4rpx;
  overflow: hidden;
}

.pos-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF7A7A 0%, #FF9999 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.pos-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pos-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.pos-count {
  font-size: 24rpx;
  color: #FF7A7A;
  font-weight: 600;
}

/* 高频错词列表 */
.wrong-words-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wrong-word-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.word-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7A7A 0%, #FF9999 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.word-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.word-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.word-meaning {
  font-size: 24rpx;
  color: #6B7280;
}

.word-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.word-pos {
  font-size: 22rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.word-count {
  font-size: 24rpx;
  color: #EF4444;
  font-weight: 600;
}

/* 导出报告 */
.export-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.export-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.export-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  border-radius: 12rpx;
  border: none;
  font-size: 28rpx;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.export-btn.pdf {
  background: linear-gradient(135deg, #FF7A7A 0%, #FF9999 100%);
  color: #FFFFFF;
}

.export-btn.word {
  background: linear-gradient(135deg, #60A5FA 0%, #93C5FD 100%);
  color: #FFFFFF;
}

.export-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.export-btn[disabled] {
  opacity: 0.5;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

.export-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.6;
}

/* 基础统计 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF7A7A;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
}

.menu-arrow {
  font-size: 36rpx;
  color: #9CA3AF;
}
