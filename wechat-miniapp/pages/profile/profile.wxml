<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息卡片（合并等级信息） -->
  <view class="user-card">
    <view class="user-left">
      <view class="user-avatar">👤</view>
      <view class="user-info">
        <text class="user-name">{{userInfo.name || '同学'}}</text>
        <text class="user-id">学号：{{userInfo.studentNo || '--'}}</text>
      </view>
    </view>
    <view class="user-level">
      <view class="level-badge">
        <text class="level-icon">⭐</text>
        <text class="level-text">Lv.{{pointsInfo.level || 1}}</text>
      </view>
      <text class="points-text">{{pointsInfo.totalPoints || 0}}积分</text>
    </view>
  </view>

  <!-- 学习数据概览 -->
  <view class="stats-section">
    <view class="stats-grid-compact">
      <view class="stat-card-compact">
        <text class="stat-value-compact">{{stats.totalWords}}</text>
        <text class="stat-label-compact">学习词汇</text>
      </view>
      <view class="stat-card-compact">
        <text class="stat-value-compact">{{stats.masteredWords}}</text>
        <text class="stat-label-compact">已掌握</text>
      </view>
      <view class="stat-card-compact accent">
        <text class="stat-value-compact">{{detailedStats.accuracy}}%</text>
        <text class="stat-label-compact">正确率</text>
      </view>
      <view class="stat-card-compact">
        <text class="stat-value-compact">{{stats.studyDays}}</text>
        <text class="stat-label-compact">学习天数</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="quick-links">
    <view class="quick-link-item" bindtap="goToStudyHistory">
      <view class="link-icon">📚</view>
      <text class="link-title">学习历史</text>
      <text class="link-arrow">›</text>
    </view>
    <view class="quick-link-item" bindtap="goToTest">
      <view class="link-icon">✍️</view>
      <text class="link-title">词汇测试</text>
      <text class="link-arrow">›</text>
    </view>
    <view class="quick-link-item" bindtap="goToAchievements">
      <view class="link-icon">🏆</view>
      <text class="link-title">我的成就</text>
      <view class="link-badge" wx:if="{{achievementCount > 0}}">{{achievementCount}}</view>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="logout">
      <text class="menu-icon">🚪</text>
      <text class="menu-label">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
