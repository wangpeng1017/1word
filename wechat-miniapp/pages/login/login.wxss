/* pages/login/login.wxss */
.login-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-container {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 40rpx;
  background: linear-gradient(135deg, #FF7A7A 0%, #D65D5D 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 122, 0.3);
}

.logo-icon {
  font-size: 96rpx;
  line-height: 1;
}

.login-header .title-large {
  font-size: 48rpx;
  font-weight: 600;
  color: #1F2937;
}

.login-form {
  width: 100%;
  max-width: 600rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #FF7A7A;
}

/* 密码输入框容器 */
.password-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
  padding-right: 88rpx;
}

/* 密码显示/隐藏图标容器 */
.password-toggle-icon {
  position: absolute;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 眼睛图标 */
.eye-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

/* 眼球 */
.eye-ball {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  transition: all 0.3s;
}

/* 隐藏状态 - 倾斜45度直线 */
.eye-icon.eye-close .eye-ball {
  width: 32rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #9CA3AF;
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 显示状态 - 圆点 */
.eye-icon.eye-open .eye-ball {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #374151;
}

/* 协议勾选框样式 */
.agreement-check {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.agreement-text {
  flex: 1;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 40rpx;
  word-wrap: break-word;
  word-break: break-all;
}

.agreement-text text {
  display: inline;
}

.agreement-link {
  color: #FF7A7A;
}

.login-footer {
  margin-top: 40rpx;
}

/* 客服按钮样式 */
.customer-service-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.cs-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.cs-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 二维码弹窗样式 */
.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.qrcode-content {
  position: relative;
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.qrcode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.qrcode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
}

.qrcode-close {
  font-size: 40rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.qrcode-body {
  padding: 40rpx;
  text-align: center;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E5E7EB;
}

.qrcode-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.qrcode-actions {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
}

.qrcode-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #374151;
  border: none;
}

.qrcode-btn::after {
  border: none;
}

.qrcode-btn-primary {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #fff;
}

.btn-text {
  background: transparent;
  color: #6B7280;
  font-size: 28rpx;
  border: none;
}

.btn-text::after {
  border: none;
}
