/* pages/leaderboard/leaderboard.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFFFFF 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

/* 榜单类型切换 */
.type-tabs {
  display: flex;
  padding: 0 32rpx 32rpx;
  gap: 16rpx;
}

.type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background: linear-gradient(135deg, #FF7A7A 0%, #FF5A5A 100%);
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 122, 0.3);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-label {
  font-size: 26rpx;
  color: #6B7280;
}

.type-tab.active .tab-label {
  color: #FFFFFF;
  font-weight: bold;
}

/* 我的排名卡片 */
.my-rank-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.3);
}

.my-rank-card .rank-badge {
  width: 80rpx;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFD700;
  margin-right: 24rpx;
}

.my-rank-card .rank-info {
  flex: 1;
}

.my-rank-card .rank-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  margin-bottom: 4rpx;
}

.my-rank-card .rank-class {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.my-rank-card .rank-points {
  text-align: right;
  margin-right: 24rpx;
}

.my-rank-card .points-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
}

.my-rank-card .points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.my-rank-card .rank-level {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 前三名 */
.top-three {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 32rpx 32rpx;
  gap: 16rpx;
}

.top-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  position: relative;
}

.top-item.first {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  transform: translateY(-20rpx);
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
}

.top-item.second {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
}

.top-item.third {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
}

.top-crown {
  position: absolute;
  top: -30rpx;
  font-size: 48rpx;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.top-rank {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.top-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.top-item.first .top-avatar {
  width: 120rpx;
  height: 120rpx;
}

.top-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.top-points {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
}

/* 排行榜列表 */
.leaderboard-list {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  margin: 0 32rpx;
}

.list-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

.list-header text:nth-child(1) {
  width: 100rpx;
}

.list-header text:nth-child(2) {
  flex: 1;
}

.list-header text:nth-child(3) {
  width: 120rpx;
  text-align: right;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.highlight {
  background: #FFF5F5;
  margin: 0 -32rpx;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
}

.rank-badge {
  width: 64rpx;
  height: 64rpx;
  background: #F3F4F6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #6B7280;
  margin-right: 24rpx;
}

.rank-badge.first {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
}

.rank-badge.second {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
  color: #FFFFFF;
}

.rank-badge.third {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
  color: #FFFFFF;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.rank-class {
  font-size: 24rpx;
  color: #9CA3AF;
}

.rank-points {
  text-align: right;
  margin-right: 24rpx;
}

.points-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF7A7A;
  display: block;
}

.points-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.rank-level {
  padding: 6rpx 12rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6B7280;
  font-weight: bold;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}
